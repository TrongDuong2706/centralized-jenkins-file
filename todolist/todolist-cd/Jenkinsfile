@Library('shared-library@main') _

node('built-in') {
    stage('Checkout Centralized Repo') {
        checkout([
            $class: 'GitSCM',
            branches: [[name: '*/main']],
            extensions: [],
            userRemoteConfigs: [[
                url: 'https://github.com/TrongDuong2706/centralized-jenkins-file.git'
            ]]
        ])
    }

    def config = readYaml file: 'todolist/todolist-cd/config.yaml'
    def pipelineTemplate = load 'shared/cd-vuejs-template.Jenkinsfile'
    pipelineTemplate.call(config)
}
